{
  "name": "adcb-reaction-timer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tsconfig.cloudflare.json && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/adcb*.test.mjs",
    "test:cloud": "node --import tsx --test tests/adcb*.test.ts tests/cloud-health.test.ts tests/cloud-schema.test.ts tests/game-pause.test.ts"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "miniflare": "^4.20260730.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.1",
    "wrangler": "^4.156.0"
  }
}
